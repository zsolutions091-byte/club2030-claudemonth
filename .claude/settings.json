{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/vault-sync-reminder.js",
            "timeout": 5,
            "statusMessage": "Checking vault sync"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/convention-check.js",
            "timeout": 5,
            "statusMessage": "Checking conventions"
          }
        ]
      }
    ]
  }
}
